{
  "manifest_version": 3,
  "name": "loop.mp3",
  "version": "0.8.1",
  "description": "A better way to experience your music.",
  "author": "Saaransh_Xd",

  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "variable.js",
        "utils/runtime.js",
        "core/bridge.js",
        "ytm/dom.js",
        "services/lyrics-providers.js",
        "services/groove.js",
        "services/lyricsplus.js",
        "services/unison.js",
        "services/binilyrics.js",
        "services/lrclib.js",
        "core/app-bootstrap.js",
        "core/provider-settings.js",
        "core/onboarding.js",
        "services/lyrics-cache.js",
        "core/dialogs.js",
        "core/preferences.js",
        "ytm/player.js",
        "utils/lyrics-parser.js",
        "services/lyrics.js",
        "core/lyrics-view.js",
        "services/lyrics-fetch.js",
        "core/kawarp.js",
        "services/metadata.js",
        "core/player.js",
        "ytm/playback.js",
        "ytm/search.js",
        "core/init.js",
        "index.js"
      ],
      "css": [
        "static/loop.css"
      ],
      "run_at": "document_start"
    }
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "permissions": [
    "storage",
    "scripting"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "config/shader.json",
        "config/presets/*",
        "modules/kawarp.js",
        "modules/braccato/*",
        "modules/braccato/styles/*",
        "ludo/index.js",
        "modules/am-lyrics.js",
        "static/fallback-artwork.png",
        "static/fallback-legacy.png",
        "static/material3-loader.svg"
      ],
      "matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "loop@saaranshdx.dev"
    }
  }
}
