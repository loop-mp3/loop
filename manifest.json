{
  "manifest_version": 3,
  "name": "loop.mp3",
  "version": "0.7.9",
  "description": "A minimal, keyboard-first music player built on top of YouTube Music. (DO NOT USE IN A BROWSER IT MAY BREAK)",
  "author": "Saaransh_Xd",
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": [
        "variable.js",
        "utils/runtime.js",
        "core/bridge.js",
        "ytm/dom.js",
        "services/lyrics-providers.js",
        "services/groove.js",
        "services/lyricsplus.js",
        "services/unison.js",
        "services/binilyrics.js",
        "services/lrclib.js",
        "core/app-bootstrap.js",
        "core/provider-settings.js",
        "core/onboarding.js",
        "services/lyrics-cache.js",
        "core/dialogs.js",
        "core/preferences.js",
        "ytm/player.js",
        "utils/lyrics-parser.js",
        "services/lyrics.js",
        "core/lyrics-view.js",
        "services/lyrics-fetch.js",
        "core/kawarp.js",
        "services/metadata.js",
        "core/player.js",
        "ytm/playback.js",
        "ytm/search.js",
        "core/init.js",
        "index.js"
      ],
      "css": ["static/loop.css"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": ["config/shader.json", "config/presets/*", "modules/kawarp.js", "modules/braccato/*", "modules/braccato/styles/*", "ludo/index.js", "static/fallback-artwork.png", "static/fallback-legacy.png", "static/material3-loader.svg"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
