{
  "manifest_version": 3,
  "name": "loop.mp3",
  "version": "1.1.2",
  "description": "A minimal, keyboard-first music player built on top of YouTube Music. (DO NOT USE IN A BROWSER IT MAY BREAK)",
  "author": "Saaransh_Xd",
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["index.js"],
      "css": ["static/loop.css"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://loop.mizucode.qzz.io/*"
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": ["config/shader.json", "config/presets/*", "modules/kawarp.js", "static/fallback-artwork.png"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
